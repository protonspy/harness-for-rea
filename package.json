{
  "name": "harness-for-rea",
  "productName": "Harness for REA",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop app where an OpenRouter orchestrator delegates deep analysis to a sandboxed Claude Code specialist.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:gate": "node scripts/test-gate.mjs",
    "lint": "oxlint --deny-warnings src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/openrouter": "^0.4.19",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "deepagents": "^1.15.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "langchain": "^1.5.19",
    "langsmith": "^0.11.1",
    "lucide-react": "1.52.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "electron@45.0.0": true
  }
}
