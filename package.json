{
  "name": "harness-for-rea",
  "productName": "Harness for REA",
  "private": true,
  "version": "0.2.0",
  "description": "Desktop app where an OpenRouter orchestrator delegates deep analysis to a sandboxed Claude Code specialist.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tui.json --noEmit",
    "test": "vitest run",
    "test:gate": "node scripts/test-gate.mjs",
    "pin-images": "node scripts/pin-images.mjs",
    "lint": "oxlint --deny-warnings src tests scripts tui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "electron-vite build && electron-builder --win",
    "tui": "bun tui/src/main.tsx",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "cli:package": "bun scripts/build-cli.ts package",
    "cli:binary": "bun scripts/build-cli.ts binary"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/openai": "^1.8.0",
    "@langchain/openrouter": "^0.4.19",
    "@lezer/common": "^1.5.5",
    "@lezer/cpp": "^1.1.6",
    "@lezer/css": "^1.3.9",
    "@lezer/go": "^1.0.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/java": "^1.1.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/python": "^1.1.19",
    "@lezer/rust": "^1.0.3",
    "@lezer/xml": "^1.0.6",
    "@lezer/yaml": "^1.0.4",
    "@opentui/core": "^0.8.1",
    "@opentui/react": "^0.8.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.4.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "deepagents": "^1.15.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "langchain": "^1.5.19",
    "langsmith": "^0.11.1",
    "lucide-react": "1.52.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "web-tree-sitter": "^0.25.10",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "electron@45.0.0": true
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2"
  }
}
