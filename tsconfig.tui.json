{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react"
  },
  "include": ["tui/src", "tui/test", "src/main/env.d.ts", "tests/fixtures/bun-*.ts", "scripts/build-cli.ts"]
}
